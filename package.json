{
	"name": "n8n-nodes-zalo-tools",
	"version": "0.1.1",
	"description": "Beta version",
	"keywords": [
		"n8n-community-node-package",
		"zalo-nodes"
	],
	"license": "MIT",
	"homepage": "",
	"author": {
		"name": "dinhtrung",
		"email": "trungduong13082000@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dinhtrung1308/zalo-node.git"
	},
	"engines": {
		"node": ">=18.10",
		"pnpm": ">=9.1"
	},
	"packageManager": "pnpm@9.1.4",
	"main": "dist/index.js",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "tsc && gulp build:icons",
		"n8n": "n8n start",
		"dev": "npm run build && npm run n8n",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes credentials package.json",
		"watch": "concurrently \"pnpm run watch\" \"pnpm run start:n8n\"",
		"start:n8n": "nodemon --watch dist --exec \"npx n8n start\""
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/ZaloApi.credentials.js",
			"dist/credentials/ZaloOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/ZaloWebhook/ZaloWebhook.node.js",
			"dist/nodes/ZaloSendMessage/ZaloSendMessage.node.js",
			"dist/nodes/ZaloAcceptFriendRequest/ZaloAcceptFriendRequest.node.js",
			"dist/nodes/ZaloAddGroupDeputy/ZaloAddGroupDeputy.node.js",
			"dist/nodes/ZaloAddReaction/ZaloAddReaction.node.js",
			"dist/nodes/ZaloFindUserInformationByPhoneNumber/ZaloFindUserInformationByPhoneNumber.node.js",
			"dist/nodes/ZaloGetGroupInfo/ZaloGetGroupInfo.node.js",
			"dist/nodes/ZaloLoginViaQRCode/ZaloLoginViaQRCode.node.js"
		]
	},
	"devDependencies": {
		"@types/qrcode": "^1.5.5",
		"@typescript-eslint/parser": "^7.15.0",
		"concurrently": "^9.1.2",
		"eslint": "^8.56.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.1",
		"gulp": "^4.0.2",
		"javascript-obfuscator": "^4.1.1",
		"nodemon": "^3.1.9",
		"prettier": "^3.3.2",
		"typescript": "^5.5.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"gulp-obfuscator": "^0.0.0",
		"gulp-terser": "^2.1.0",
		"gulp-typescript": "6.0.0-alpha.1",
		"n8n": "^1.84.1",
		"n8n-nodes-zalo-user": "^0.0.12",
		"n8n-nodes-zalo-vn": "^0.1.3",
		"node-notifier": "^10.0.1",
		"pnpm": "^10.6.5",
		"qrcode": "^1.5.4",
		"sqlite3": "^5.1.7",
		"zca-js": "2.0.0-beta.14"
	}
}
